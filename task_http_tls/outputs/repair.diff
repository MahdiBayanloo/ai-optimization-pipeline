#include "TlsHandshakeAdapter.h"

// Async entry point - returns adapter for non-blocking handshake
// Ownership: Caller takes ownership of *outAdapter and MUST call 
// httpServerTlsHandshakeCleanup() when handshake completes or on error
inline error_t httpServerEstablishSecureConnectionAsync(
    HttpServerContext* serverContext,
    HttpConnection* connection,
    TlsHandshakeAdapter** outAdapter)
{
    if (connection == nullptr || serverContext == nullptr || outAdapter == nullptr) {
        return ERROR_INVALID_PARAMETER;
    }

    TlsHandshakeAdapter* adapter = new TlsHandshakeAdapter();
    
    error_t error = adapter->start(serverContext, connection);
    
    if (error != NO_ERROR) {
        delete adapter;
        *outAdapter = nullptr;
        return error;
    }

    *outAdapter = adapter;
    return NO_ERROR;
}

// Tick helper - advances handshake one step
// Returns completion event for caller to deliver via seve event channel (Rule 8)
inline TlsHandshakeStatus httpServerTlsHandshakeTick(
    TlsHandshakeAdapter* adapter,
    bool* outComplete,
    TlsHandshakeCompleteEvent* outEvent)
{
    if (adapter == nullptr) {
        if (outComplete) *outComplete = true;
        if (outEvent) *outEvent = TlsHandshakeCompleteEvent(nullptr, ERROR_INVALID_PARAMETER, false);
        return TlsHandshakeStatus::ERROR;
    }

    TlsHandshakeStatus status = adapter->progress();

    bool isComplete = (status == TlsHandshakeStatus::DONE || status == TlsHandshakeStatus::ERROR);
    
    if (outComplete) *outComplete = isComplete;
    if (outEvent && isComplete) *outEvent = adapter->getCompletionEvent();

    return status;
}

// Cleanup helper - MUST be called after handshake completes (success or error)
// Releases ownership of adapter allocated by httpServerEstablishSecureConnectionAsync
inline void httpServerTlsHandshakeCleanup(TlsHandshakeAdapter* adapter) {
    delete adapter;
}
