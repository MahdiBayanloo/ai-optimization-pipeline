            if (outComplete) *outComplete = true;
            if (outError) *outError = NO_ERROR;
            // Fire completion callback for event channel delivery
            adapter->fireCompletion();
            break;

        case TlsHandshakeStatus::ERROR:
            if (outComplete) *outComplete = true;
            if (outError) *outError = adapter->getError();
            // Fire completion callback with error
            adapter->fireCompletion();
            break;

