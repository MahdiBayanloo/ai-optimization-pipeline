// Pattern 2: Include the adapter layer for non-blocking TLS handshake
#include "TlsHandshakeAdapter.h"

// Pattern 3: Callback Wrapper - Async entry point for seve activities
// Returns adapter that caller uses to drive handshake via progress() calls

/**
 * @brief Start a non-blocking TLS handshake on an HTTP connection
 * 
 * This is the non-blocking replacement for httpServerEstablishSecureConnection.
 * Call this once to initialize, then call adapter->progress() each event loop tick.
 * 
 * Usage in seve Activity:
 *   1. Call httpServerEstablishSecureConnectionAsync() - returns immediately
 *   2. Store returned adapter in connection user data
 *   3. Each tick: call adapter->progress()
 *   4. When progress() returns DONE or ERROR, fire completion event
 * 
 * @param connection The HTTP connection (must have TLS context initialized via 
 *                   httpServerOpenSecureConnection first)
 * @param outAdapter Output parameter - receives pointer to adapter instance
 *                   Caller is responsible for adapter lifetime management
 * @return NO_ERROR on successful start, error code otherwise
 * 
 * IMPORTANT: This function returns immediately. The handshake is NOT complete
 * until adapter->progress() returns TlsHandshakeStatus::DONE
 */
inline error_t httpServerEstablishSecureConnectionAsync(
    HttpConnection* connection,
    TlsHandshakeAdapter** outAdapter)
{
    // Validate parameters
    if (connection == nullptr || outAdapter == nullptr) {
        return ERROR_INVALID_PARAMETER;
    }

    // Verify TLS context exists (should be created by httpServerOpenSecureConnection)
    if (connection->tlsContext == nullptr) {
        return ERROR_NOT_CONFIGURED;
    }

    // Pattern 2: Create adapter instance
    // Memory management note: caller owns this instance and must delete when done
    TlsHandshakeAdapter* adapter = new TlsHandshakeAdapter();
    
    // Pattern 3: start() returns immediately - no blocking
    error_t error = adapter->start(connection);
    
    if (error != NO_ERROR) {
        delete adapter;
        *outAdapter = nullptr;
        return error;
    }

    *outAdapter = adapter;
    return NO_ERROR;
}

